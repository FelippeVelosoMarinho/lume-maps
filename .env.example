# ── Docker local (scripts/deploy.sh) ─────────────────────────────
POSTGRES_USER=lume
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=lume_maps
SECRET_KEY=troque_esta_chave_jwt_longa
FRONTEND_URL=http://localhost
HTTP_PORT=80

# ── API (local / Vercel / Supabase) ───────────────────────────────
# SQLite (dev local):
# DATABASE_URL=sqlite+aiosqlite:///./mapa_retrato.db
# UPLOAD_DIR=./uploads

# Supabase Postgres (use Transaction pooler, porta 6543):
# DATABASE_URL=postgresql+asyncpg://postgres.[ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres

# Supabase Storage (uploads server-side):
# SUPABASE_URL=https://[ref].supabase.co
# SUPABASE_SERVICE_KEY=eyJ...   # service_role — nunca no front
# SUPABASE_STORAGE_BUCKET=uploads

# Migração one-shot (criar tabelas no boot):
# RUN_MIGRATIONS=true

# ── Vercel (build do front) ───────────────────────────────────────
# VITE_API_BASE=/api
# VITE_CARTO_API_KEY=...   # grátis em https://carto.com/basemaps/apikey
